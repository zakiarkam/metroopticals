# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env
.env.local
.env.production

# Database dumps
backups/
*.sql
*.sql.gz
# ...but Prisma migrations are source code and must be committed, otherwise
# `prisma migrate deploy` finds nothing to apply and the deploy creates no tables.
!prisma/migrations/**/*.sql

# Railway CLI
.railway/

docs/
*.log
/logs/

# Extra build dirs used by a second dev server (see NEXT_DIST_DIR)
.next-*


# Generated ad artwork awaiting upload via the admin panel
/ad-creatives/

# Database snapshots taken before destructive scripts  never commit data.
/backups/

# Virtual try-on runtime (WebAssembly, landmark model, decoders) copied from
# node_modules / downloaded by `npm run tryon:runtime`. Production serves it
# from the bucket instead  see `npm run tryon:publish`.
/public/tryon-runtime/

# Generated sample frame photos for trying the virtual try-on  never commit
/tryon-samples/
