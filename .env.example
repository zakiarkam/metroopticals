# ==============================================
# Metro Opticals  Local environment template
# Copy to `.env` and fill in the values:  cp .env.example .env
#
# This file is for LOCAL development only. The deployed environments get their
# values from the Railway dashboard  see RAILWAY.md for that list.
# ==============================================

# ---------- Database ----------
# Local Postgres, or a Railway database reached over its PUBLIC proxy host.
# The `*.railway.internal` host only resolves from inside Railway, so it can
# never be used from your machine.
# Prisma uses this for both runtime queries and migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/metro_dev"

# ---------- NextAuth ----------
NEXTAUTH_URL="http://localhost:4500"
# Must be at least 32 characters. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace_with_a_long_random_string_at_least_32_chars"

# ---------- Google OAuth (optional) ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Cloudflare R2 storage ----------
# Public read URL (r2.dev subdomain or your custom domain).
# NOTE: every NEXT_PUBLIC_* value is compiled into the browser bundle at BUILD
# time, so changing one on Railway requires a redeploy, not just a restart.
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
R2_BUCKET_NAME="your-bucket-name"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# ---------- Virtual try-on ----------
# Where the face-tracking runtime (WebAssembly, landmark model, 3D decoders)
# is served from. Leave unset locally and run `npm run tryon:runtime` once,
# which copies it under public/tryon-runtime. In production run
# `npm run tryon:publish` once and set this to the URL it prints, so the
# ~20 MB runtime is served from the bucket (no egress charge) and not from
# the app container. Build-time value.
# NEXT_PUBLIC_TRYON_RUNTIME_URL="https://pub-xxxxxxxx.r2.dev/tryon-runtime/v1.0.1"
# Global kill switch  "false" hides every Try On button without touching
# the database. Build-time value.
NEXT_PUBLIC_TRYON_ENABLED="true"

# ---------- Email (Resend) ----------
RESEND_API_KEY=""
EMAIL_FROM="Metro Opticals <hello@metroopticals.lk>"
# Leave true locally so no real mail is sent while developing.
USE_MOCK_EMAIL=true

# ---------- Store contact details ----------
ADMIN_EMAIL="hello@metroopticals.lk"
# Where new-order and contact-form WhatsApp alerts go (digits, country code first).
ADMIN_PHONE="94766638682"
NEXT_PUBLIC_SITE_URL="http://localhost:4500"
NEXT_PUBLIC_WHATSAPP_NUMBER="94766638682"

# ---------- WhatsApp sending (WaSender) ----------
# Leave blank to disable. Without a key no message is sent and the code
# reports `success: false`  it never pretends a message went out.
WASENDER_API_KEY=""
WASENDER_API_URL="https://wasenderapi.com/api/send-message"

# ---------- First admin login ----------
# Read by `npm run db:bootstrap` (and by the Railway pre-deploy command) to
# create or promote the SUPER_ADMIN account. Both must be set for it to run.
# The password must be 12+ characters and must not be a known placeholder.
ADMIN_BOOTSTRAP_EMAIL="admin@metroopticals.lk"
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME="Administrator"
# Set to "true" for exactly one deploy to rotate an existing admin's password,
# then remove it again.
ADMIN_BOOTSTRAP_RESET_PASSWORD="false"

# ---------- Logging ----------
# "info" normally; "debug" while chasing something down.
LOG_LEVEL="info"
# Write log files as well as stdout. Leave unset on Railway  the container
# filesystem is wiped on every deploy, so only stdout is actually readable.
# LOG_TO_FILE="true"

# ---------- PayHere payment gateway ----------
# Online card payments (Visa / Mastercard / Amex and mobile wallets) in LKR.
#
# Before any of this works, log in at https://www.payhere.lk (live) or
# https://sandbox.payhere.lk (test) and register this site's domain under
# Settings -> Domains & Credentials. PayHere refuses payments from a domain it
# does not know, and that is also where the merchant secret below comes from.
#
# That registration is a SECURITY control, not just setup: it is what stops
# `notify_url` being repointed at someone else's collector. PayHere's signature
# concatenates its fields without separators, and intercepting the callback is
# the missing half of forging one. See the README section
# "Why registering the domain is not optional" before going live.

# Shows the "Pay online" option at checkout and the accepted-card logos in the
# footer. Off, the storefront offers only cash and bank transfer and nothing
# PayHere-related is rendered anywhere. Turn it on (with MODE=sandbox) before
# submitting the site for PayHere activation, so their reviewer can see the
# payment logos and the policy pages. Build-time value.
NEXT_PUBLIC_PAYHERE_ENABLED="false"

# "sandbox" (test cards, no real money) or "live". Anything that is not
# exactly "live" is treated as sandbox, so a typo can never charge a real
# card. Build-time value.
NEXT_PUBLIC_PAYHERE_MODE="sandbox"

# The surcharge added to card orders, as a percent of the order. Shown on the
# checkout before the customer commits, and printed on the invoice. Set to "0"
# to charge nothing. Build-time value.
NEXT_PUBLIC_PAYHERE_FEE_PERCENT="2.5"
# What that line is called on the checkout, the invoice and the terms page.
# Defaults to "Online payment fee (2.5%)". Only call it VAT if it really is
# VAT you are registered to collect -- a gateway surcharge is not.
# NEXT_PUBLIC_PAYHERE_FEE_LABEL="Online payment fee (2.5%)"

# From the PayHere dashboard. The secret signs every payment and verifies
# every callback: it is server-only and must NEVER be given a NEXT_PUBLIC_
# prefix, or it ends up in the browser bundle and anyone can mark bills paid.
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""

# Where PayHere posts the payment result, server to server. Leave unset in
# production -- it is built from NEXT_PUBLIC_SITE_URL. Set it only while
# testing against the sandbox from a laptop, where PayHere cannot reach
# localhost: run a tunnel (ngrok, cloudflared) and put its public URL here.
# PAYHERE_NOTIFY_URL="https://your-tunnel.ngrok-free.app/api/payments/payhere/notify"

# ---------- Prescription reading (optional) ----------
# Lets a customer upload a photo or PDF of their prescription instead of
# typing it in. Gemini Flash reads the sphere, cylinder, axis, addition and PD
# off the image as structured JSON; the customer still confirms every number
# on the form before anything is priced or saved, and the file itself is never
# stored.
#
# Leave the key unset and the "Upload a photo" option simply does not appear
# -- the manual form and saved prescriptions both work regardless.
#
# Cost control is built in: reasoning is set to "minimal" (measured on a real
# slip -- zero thinking tokens and the same accuracy as the levels above it),
# output is capped, and every read is cached by the file's own SHA-256, so the
# same photo is never billed twice. A read costs a fraction of a cent.

# Which reader to use. Only "gemini" is implemented today.
PRESCRIPTION_OCR_PROVIDER="gemini"
# From https://aistudio.google.com/apikey -- there is a free tier. Server-only:
# never give this a NEXT_PUBLIC_ prefix. (GOOGLE_API_KEY works as a fallback.)
GEMINI_API_KEY=""
# The model. Defaults to gemini-3.6-flash.
#
# Google RETIRES these: gemini-2.5-flash started answering 404 "no longer
# available to new users" and every upload broke until the name was changed.
# So if the pinned model 404s, the code automatically falls back to the rolling
# "gemini-flash-latest" alias and logs an error telling you to update this --
# uploads keep working, but do update it when you see that log.
# GEMINI_MODEL="gemini-3.6-flash"
# Only set this to point at a proxy or a different API version. Note that a
# fixed URL here also pins the model, so the retirement fallback above cannot
# help; prefer GEMINI_MODEL.
# GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent"

# ---------- Node ----------
NODE_ENV=development
