generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Railway Postgres is not pooled, so there is no pooled/direct split to
  // model: migrations and runtime queries use the same connection string.
  url      = env("DATABASE_URL")
}

model User {
  name              String?
  email             String               @unique
  emailVerified     DateTime?
  password          String?
  image             String?
  role              UserRole             @default(CUSTOMER)
  customerType      CustomerType         @default(END_USER)
  phone             String?
  address           String?
  city              String?
  country           String?
  postalCode        String?
  /// Set whenever the password is changed or reset. Any session issued before
  /// this moment is refused, so a stolen login dies with the old password.
  passwordChangedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  id                Int                  @id @default(autoincrement())
  accounts          Account[]
  cartItems         CartItem[]
  orders            Order[]              @relation("OrderCustomer")
  resetTokens       PasswordResetToken[]
  reviews           Review[]
  sessions          Session[]
  wishlistItems     WishlistItem[]

  // Counter staff: the bills, payments and stock corrections this admin made.
  billedOrders   Order[]         @relation("OrderCashier")
  payments       Payment[]
  stockMovements StockMovement[]

  @@map("users")
}

model Account {
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  id                Int     @id @default(autoincrement())
  userId            Int
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  expires      DateTime
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Category {
  name        String
  slug        String     @unique
  description String?
  image       String?
  status      String     @default("active")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  id          Int        @id @default(autoincrement())
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]  @relation("ProductCategory")

  @@map("categories")
}

model Product {
  title           String
  slug            String      @unique
  description     String?
  price           Float
  discountedPrice Float?
  images          String[]
  catalogueFile   String?
  stock           Int         @default(0)
  status          String      @default("ACTIVE")
  // Shop identifiers. `sku` is your own code; `barcode` is what a scanner
  // reads at the counter  scanning types the digits into the POS search box,
  // and an exact match adds the line straight to the bill.
  sku             String?     @unique
  barcode         String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  unitType        ProductUnit @default(PIECES)

  // ---- Eyewear specification (optional: only frames use these) ----
  // The three measurements printed on a frame, e.g. 50 □ 17 - 140
  lensWidth     Int? // mm, per lens
  bridgeWidth   Int? // mm, gap between lenses
  templeLength  Int? // mm, arm length
  frameColors   String[] // a frame is often sold in several colourways
  frameMaterial String?
  weightGrams   Float?
  frameShape    FrameShape?
  rimType       RimType?
  gender        Gender?

  // Denormalised review aggregates. Recomputed whenever a review is published,
  // edited or removed, so listing pages can sort and display stars without
  // joining every review row on every query.
  rating      Float? // null until the first published review
  reviewCount Int    @default(0)

  id             Int             @id @default(autoincrement())
  categoryId     Int?
  brandId        Int?
  advertisements Advertisement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reviews        Review[]
  brand          Brand?          @relation(fields: [brandId], references: [id])
  category       Category?       @relation("ProductCategory", fields: [categoryId], references: [id])
  wishlistItems  WishlistItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([brandId])
  @@index([gender])
  @@index([status])
  @@index([slug])
  @@index([stock])
  @@map("products")
}

model CartItem {
  quantity  Int      @default(1)
  // The colourway the shopper picked on the product page. Empty when the
  // product lists no colours  an empty string rather than null so the unique
  // index below still collapses repeat adds (Postgres treats NULLs as
  // distinct, which would let the same frame stack up as separate rows).
  color     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per colourway, so black and tortoise of the same frame are two
  // lines in the cart rather than one line with a lost choice.
  @@unique([userId, productId, color])
  @@map("cart_items")
}

model WishlistItem {
  createdAt DateTime @default(now())
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Order {
  orderNumber    String      @unique
  status         OrderStatus @default(PENDING)
  totalAmount    Float
  shippingFee    Float       @default(0)
  subtotal       Float
  paymentMethod  String?
  shippingMethod String?
  notes          String?

  /// Where the sale happened. ONLINE is a storefront checkout; POS is a bill
  /// written at the shop counter. Both live in this table on purpose, so the
  /// dashboard, the monthly report and stock all count shop sales without a
  /// second set of queries.
  channel        OrderChannel  @default(ONLINE)
  /// How much of the bill has actually been collected. A customer can pay an
  /// advance and settle the rest on collection, so this is not derivable from
  /// the status alone.
  paymentStatus  PaymentStatus @default(PENDING)
  /// Bill-level discount in rupees, on top of any per-line discount.
  discountAmount Float         @default(0)
  /// Sum of the payment rows, kept here so lists do not have to aggregate.
  amountPaid     Float         @default(0)
  /// When the rest of the money is expected, on a bill the customer is paying
  /// off later. Null once nothing is owed. This is what turns "part paid" into
  /// something the shop can actually chase.
  balanceDueDate DateTime?
  /// Set when a bill is cancelled after the fact; stock is returned and the
  /// row is kept for the audit trail rather than deleted.
  voidedAt       DateTime?
  voidReason     String?

  /// Who the bill is made out to. Always present  a walk-in customer with no
  /// name recorded is billed as "Walk-in customer".
  billingName        String
  /// Everything below is optional since the counter started billing: someone
  /// buying a frame over the counter gives a phone number at most, and nothing
  /// is being shipped anywhere.
  billingEmail       String?
  billingPhone       String
  billingAddress     String?
  billingCity        String?
  billingCountry     String?
  billingPostalCode  String?
  shippingName       String?
  shippingEmail      String?
  shippingPhone      String?
  shippingAddress    String?
  shippingCity       String?
  shippingCountry    String?
  shippingPostalCode String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  id                 Int      @id @default(autoincrement())

  /// The storefront account that placed the order. Null for a counter sale by
  /// someone who has no account  the bill still names them through
  /// `customer` and the billing fields.
  userId      Int?
  /// The shop's own customer book entry, used by the counter.
  customerId  Int?
  /// The admin who wrote the bill. Null for storefront orders.
  createdById Int?

  items          OrderItem[]
  payments       Payment[]
  stockMovements StockMovement[]
  user           User?           @relation("OrderCustomer", fields: [userId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("OrderCashier", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([channel, createdAt])
  @@index([paymentStatus])
  @@index([balanceDueDate])
  @@index([customerId])
  @@index([createdById])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  quantity        Int
  price           Float
  discountedPrice Float?
  /// The product name as it was when sold. A counter line can also be a
  /// service that is not in the catalogue at all (an eye test, a lens
  /// fitting, a repair), in which case this is the only name the line has.
  title           String?
  /// Per-line discount in rupees, applied before the bill-level discount.
  lineDiscount    Float    @default(0)
  /// How many of this line have since been returned by the customer.
  returnedQty     Int      @default(0)
  // Copied from the cart line at checkout so the picking slip still says
  // "Tortoise" after the product's colour list is edited.
  color           String?
  createdAt       DateTime @default(now())
  id              Int      @id @default(autoincrement())
  orderId         Int
  /// Null for a service line, and null once a product is deleted  a sale
  /// that has already happened must survive the catalogue being tidied up.
  productId       Int?
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model ContactMessage {
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("unread")
  createdAt DateTime @default(now())
  id        Int      @id @default(autoincrement())

  @@map("contact_messages")
}

model Advertisement {
  title      String
  // Optional: a product-driven placement can run on the linked product's own
  // photo, so an ad is publishable with artwork, with a product, or with both.
  imageUrl   String?
  link       String?
  placement  String
  status     String    @default("active")
  priority   Int       @default(0)
  slot       Int       @default(1)
  startDate  DateTime?
  endDate    DateTime?
  clickCount Int       @default(0)
  viewCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  id         Int       @id @default(autoincrement())
  productId  Int?
  product    Product?  @relation(fields: [productId], references: [id])

  @@index([status])
  @@index([placement])
  @@index([priority])
  @@index([productId])
  @@map("advertisements")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum ProductUnit {
  METER
  PIECES
  BOX
  DRUM
}

/// Eyewear brands. Separate from Category because one brand (e.g. Ray-Ban)
/// sells across several categories, which a child-category cannot express.
model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  logo      String?
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([status])
  @@map("brands")
}

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

enum FrameShape {
  RECTANGLE
  SQUARE
  ROUND
  OVAL
  CAT_EYE
  AVIATOR
  GEOMETRIC
  BROWLINE
}

enum RimType {
  FULL_RIM
  SEMI_RIMLESS
  RIMLESS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum AdvertisementStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  END_USER
  WHOLESALER
  RESELLER
  INSTALLER
  PROJECTS
  COMPANY
}

// Editable storefront content.
//
// Every non-catalogue block on the site  the announcement bar, the mega menu,
// the home page sections, the footer  is stored here as one row of JSON keyed
// by a stable string. The shape of each row is described in code by the block
// registry (src/features/site-content/constants/blocks.ts), which also supplies
// the defaults, so a missing row renders the shipped dummy content rather than
// an empty page. That keeps the schema stable while blocks gain fields.
model SiteContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

// A customer's review of a product.
//
// Reviews are user-generated, not editable site content: an admin can approve,
// reject or delete one, but never write one. New reviews land as PENDING so a
// human sees them before they reach the storefront.
//
// One review per customer per product (@@unique)  the write form switches to
// "edit your review" when a row already exists, rather than stacking duplicates.
model Review {
  id               Int          @id @default(autoincrement())
  rating           Int // 1–5
  title            String?
  body             String
  status           ReviewStatus @default(PENDING)
  // Set at submission time by checking the customer's delivered orders, so the
  // badge stays true even if the product is later removed from their history.
  verifiedPurchase Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  productId Int
  userId    Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([status])
  @@map("reviews")
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/// The shop's own customer book, used by the counter.
///
/// Separate from `User`: a walk-in customer has no login, no password and no
/// cart  only a phone number the cashier types to pull up their details and
/// their past bills. Someone who later creates a storefront account keeps both
/// records; the bill links to whichever one identified them.
model Customer {
  id             Int       @id @default(autoincrement())
  name           String
  /// The lookup key at the counter, so it has to be unique.
  phone          String    @unique
  email          String?
  address        String?
  city           String?
  /// Free notes the counter keeps  frame preference, collection instructions.
  notes          String?
  /// The customer said yes to hearing about offers. Off until they do: a
  /// phone number given to collect a bill is not permission to market to it.
  marketingOptIn Boolean   @default(false)
  /// When they last bought something, so the book can be read as a list of
  /// who to call and who has drifted away.
  lastVisitAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders Order[]

  @@index([name])
  @@index([marketingOptIn])
  @@index([lastVisitAt])
  @@map("customers")
}

/// One collection against a bill.
///
/// A bill can be settled in parts  half cash and half card, or an advance now
/// and the balance on collection  so payments are rows rather than a single
/// method column on the order.
model Payment {
  id        Int           @id @default(autoincrement())
  orderId   Int
  method    PaymentMethod
  /// Positive for a collection, negative for a refund against a return.
  amount    Float
  /// Card slip number, bank transfer reference, or a note on a refund.
  reference String?
  createdAt DateTime      @default(now())

  createdById Int?
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
  @@map("payments")
}

/// Every change to a product's stock, and why it happened.
///
/// `Product.stock` is the running count; this is the history behind it, so a
/// count that looks wrong can be traced back to the sale, the return or the
/// correction that moved it.
model StockMovement {
  id        Int         @id @default(autoincrement())
  productId Int
  /// Signed change: -2 sold, +10 received.
  delta     Int
  reason    StockReason
  /// The bill this movement belongs to, when there is one.
  orderId   Int?
  note      String?
  createdAt DateTime    @default(now())

  createdById Int?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order       Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([reason])
  @@map("stock_movements")
}

enum OrderChannel {
  ONLINE
  POS
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
}

enum StockReason {
  SALE
  ONLINE_ORDER
  RETURN
  VOID
  PURCHASE
  ADJUSTMENT
}
