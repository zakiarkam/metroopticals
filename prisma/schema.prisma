generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Railway Postgres is not pooled, so there is no pooled/direct split to
  // model: migrations and runtime queries use the same connection string.
  url      = env("DATABASE_URL")
}

model User {
  name              String?
  email             String               @unique
  emailVerified     DateTime?
  password          String?
  image             String?
  role              UserRole             @default(CUSTOMER)
  customerType      CustomerType         @default(END_USER)
  phone             String?
  address           String?
  city              String?
  country           String?
  postalCode        String?
  /// Set whenever the password is changed or reset. Any session issued before
  /// this moment is refused, so a stolen login dies with the old password.
  passwordChangedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  id                Int                  @id @default(autoincrement())
  accounts          Account[]
  cartItems         CartItem[]
  orders            Order[]              @relation("OrderCustomer")
  resetTokens       PasswordResetToken[]
  reviews           Review[]
  sessions          Session[]
  wishlistItems     WishlistItem[]
  prescriptions     Prescription[]

  // Counter staff: the bills, payments and stock corrections this admin made.
  billedOrders   Order[]         @relation("OrderCashier")
  payments       Payment[]
  stockMovements StockMovement[]

  @@map("users")
}

model Account {
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  id                Int     @id @default(autoincrement())
  userId            Int
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  expires      DateTime
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Category {
  name        String
  slug        String     @unique
  description String?
  image       String?
  status      String     @default("active")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  id          Int        @id @default(autoincrement())
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]  @relation("ProductCategory")

  @@map("categories")
}

model Product {
  title           String
  slug            String      @unique
  description     String?
  price           Float
  discountedPrice Float?
  images          String[]
  catalogueFile   String?
  stock           Int         @default(0)
  status          String      @default("ACTIVE")
  // Shop identifiers. `sku` is your own code; `barcode` is what a scanner
  // reads at the counter  scanning types the digits into the POS search box,
  // and an exact match adds the line straight to the bill.
  sku             String?     @unique
  barcode         String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  unitType        ProductUnit @default(PIECES)

  // ---- Eyewear specification (optional: only frames use these) ----
  // The three measurements printed on a frame, e.g. 50 □ 17 - 140
  lensWidth     Int? // mm, per lens
  bridgeWidth   Int? // mm, gap between lenses
  templeLength  Int? // mm, arm length
  frameColors   String[] // a frame is often sold in several colourways
  frameMaterial String?
  weightGrams   Float?
  frameShape    FrameShape?
  rimType       RimType?
  gender        Gender?

  // Denormalised review aggregates. Recomputed whenever a review is published,
  // edited or removed, so listing pages can sort and display stars without
  // joining every review row on every query.
  rating      Float? // null until the first published review
  reviewCount Int    @default(0)

  id             Int                 @id @default(autoincrement())
  categoryId     Int?
  brandId        Int?
  advertisements Advertisement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reviews        Review[]
  brand          Brand?              @relation(fields: [brandId], references: [id])
  category       Category?           @relation("ProductCategory", fields: [categoryId], references: [id])
  wishlistItems  WishlistItem[]
  stockMovements StockMovement[]
  tryOnAssets    ProductTryOnAsset[]
  colorStocks    ProductColorStock[]

  @@index([categoryId])
  @@index([brandId])
  @@index([gender])
  @@index([status])
  @@index([slug])
  @@index([stock])
  @@map("products")
}

/// What one colourway carries: its shelf count and its photo.
///
/// `Product.stock` stays the authoritative total  the POS, the reports and
/// the stock ledger all read it  and these rows split that total per colour
/// so the storefront can grey out a sold-out colourway. A colour with a NULL
/// count (and any colour with no row at all) is uncounted and falls back to
/// the total, so nothing recorded before per-colour stock existed changes.
model ProductColorStock {
  id        Int     @id @default(autoincrement())
  productId Int
  /// Matches an entry in Product.frameColors.
  color     String
  /// NULL until the colour has been counted; 0 means sold out.
  stock     Int?
  /// One of Product.images  the photo the gallery jumps to when the
  /// shopper picks this colour.
  image     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, color])
  @@index([productId])
  @@map("product_color_stocks")
}

/// How a try-on asset was produced, so the page can label a template-built
/// frame honestly and so those frames can be found and upgraded later.
enum TryOnSource {
  TEMPLATE // generated from a parametric shape template driven by the catalogue mm
  SCAN // photogrammetry or a vendor 3D studio
  VENDOR // licensed from a frame database
  PHOTO // 2D cut-out only
}

/// What the virtual try-on draws for one colourway of a frame. Kept off
/// `Product.images`  that array is the ordered gallery  and per colour,
/// which the bare `frameColors` list cannot express.
model ProductTryOnAsset {
  id        Int    @id @default(autoincrement())
  productId Int
  /// Matches an entry in Product.frameColors.
  colour    String

  /// R2 filename of the transparent front-on cut-out (2D tier).
  overlayImage String?
  /// R2 filename of the real-scale GLB (3D tier).
  modelGlb     String?
  /// Caliper reading across the hinges. Authoritative: overrides the width
  /// derived from lensWidth + bridgeWidth + rim thickness when present.
  frameWidthMm Float?

  source   TryOnSource @default(PHOTO)
  /// False until it passes the QA checklist. Also the per-product rollout
  /// flag: a product with no active asset shows no Try On button.
  isActive Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, colour])
  @@index([productId])
  @@map("product_tryon_assets")
}

model CartItem {
  quantity       Int      @default(1)
  // The colourway the shopper picked on the product page. Empty when the
  // product lists no colours  an empty string rather than null so the unique
  // index below still collapses repeat adds (Postgres treats NULLs as
  // distinct, which would let the same frame stack up as separate rows).
  color          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // ---- Prescription lenses fitted to this frame (all optional) ----
  // A frame can be bought bare, so every column below is null on an ordinary
  // line. `lensPrice` is the quoted price for the PAIR of lenses, frozen when
  // the shopper accepted the quote, and re-checked against the live price
  // list at checkout so a stale basket cannot buy last month's price.
  lensTypeId     Int?
  lensDesignId   Int?
  lensTintId     Int?
  prescriptionId Int?
  lensPrice      Float    @default(0)

  /// What makes two lines of the same frame and colour different: the lens
  /// choice. Empty for a bare frame, so repeat adds still collapse into one
  /// line exactly as they did before lenses existed, while a second pair of
  /// the same frame made to a different prescription becomes its own line.
  lensSignature String @default("")

  id        Int     @id @default(autoincrement())
  userId    Int
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  lensType     LensType?     @relation(fields: [lensTypeId], references: [id], onDelete: SetNull)
  lensDesign   LensDesign?   @relation(fields: [lensDesignId], references: [id], onDelete: SetNull)
  lensTint     LensTint?     @relation(fields: [lensTintId], references: [id], onDelete: SetNull)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  // One row per colourway *and* lens choice, so black and tortoise of the
  // same frame are two lines rather than one line with a lost choice, and so
  // are two pairs of the same frame made to two different prescriptions.
  @@unique([userId, productId, color, lensSignature])
  @@index([prescriptionId])
  @@map("cart_items")
}

model WishlistItem {
  createdAt DateTime @default(now())
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Order {
  orderNumber    String      @unique
  status         OrderStatus @default(PENDING)
  totalAmount    Float
  shippingFee    Float       @default(0)
  subtotal       Float
  paymentMethod  String?
  shippingMethod String?
  notes          String?

  /// Where the sale happened. ONLINE is a storefront checkout; POS is a bill
  /// written at the shop counter. Both live in this table on purpose, so the
  /// dashboard, the monthly report and stock all count shop sales without a
  /// second set of queries.
  channel        OrderChannel  @default(ONLINE)
  /// How much of the bill has actually been collected. A customer can pay an
  /// advance and settle the rest on collection, so this is not derivable from
  /// the status alone.
  paymentStatus  PaymentStatus @default(PENDING)
  /// Bill-level discount in rupees, on top of any per-line discount.
  discountAmount Float         @default(0)
  /// Surcharge added for paying online through the card gateway, in rupees.
  /// Kept out of `shippingFee` and `subtotal` so the invoice can name it for
  /// what it is, and so a bill paid in cash never carries one.
  paymentFee     Float         @default(0)
  /// Sum of the payment rows, kept here so lists do not have to aggregate.
  amountPaid     Float         @default(0)
  /// When the rest of the money is expected, on a bill the customer is paying
  /// off later. Null once nothing is owed. This is what turns "part paid" into
  /// something the shop can actually chase.
  balanceDueDate DateTime?
  /// Set when a bill is cancelled after the fact; stock is returned and the
  /// row is kept for the audit trail rather than deleted.
  voidedAt       DateTime?
  voidReason     String?

  /// Who the bill is made out to. Always present  a walk-in customer with no
  /// name recorded is billed as "Walk-in customer".
  billingName        String
  /// Everything below is optional since the counter started billing: someone
  /// buying a frame over the counter gives a phone number at most, and nothing
  /// is being shipped anywhere.
  billingEmail       String?
  billingPhone       String
  billingAddress     String?
  billingCity        String?
  billingCountry     String?
  billingPostalCode  String?
  shippingName       String?
  shippingEmail      String?
  shippingPhone      String?
  shippingAddress    String?
  shippingCity       String?
  shippingCountry    String?
  shippingPostalCode String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  id                 Int      @id @default(autoincrement())

  /// The storefront account that placed the order. Null for a counter sale by
  /// someone who has no account  the bill still names them through
  /// `customer` and the billing fields.
  userId      Int?
  /// The shop's own customer book entry, used by the counter.
  customerId  Int?
  /// The admin who wrote the bill. Null for storefront orders.
  createdById Int?

  items          OrderItem[]
  payments       Payment[]
  stockMovements StockMovement[]
  user           User?           @relation("OrderCustomer", fields: [userId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("OrderCashier", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([channel, createdAt])
  @@index([paymentStatus])
  @@index([balanceDueDate])
  @@index([customerId])
  @@index([createdById])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  quantity        Int
  price           Float
  discountedPrice Float?
  /// The product name as it was when sold. A counter line can also be a
  /// service that is not in the catalogue at all (an eye test, a lens
  /// fitting, a repair), in which case this is the only name the line has.
  title           String?
  /// Per-line discount in rupees, applied before the bill-level discount.
  lineDiscount    Float    @default(0)
  /// How many of this line have since been returned by the customer.
  returnedQty     Int      @default(0)
  // Copied from the cart line at checkout so the picking slip still says
  // "Tortoise" after the product's colour list is edited.
  color           String?
  createdAt       DateTime @default(now())
  id              Int      @id @default(autoincrement())
  orderId         Int
  /// Null for a service line, and null once a product is deleted  a sale
  /// that has already happened must survive the catalogue being tidied up.
  productId       Int?
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // ---- Prescription lenses, frozen at the moment of sale ----
  // Names and money are copied rather than joined: the price list is edited,
  // lens types are retired and a customer replaces a prescription with a
  // newer version, and none of that may rewrite an invoice already issued.
  lensTypeId     Int?
  lensName       String?
  /// The build as sold — "Progressive — Free Form". Frozen like the name.
  lensDesignId   Int?
  lensDesignName String?
  lensTintName   String?
  /// Price for the pair of lenses on this line, per frame.
  lensPrice      Float   @default(0)
  /// The powers exactly as they were sent to the lab, as JSON. The live row
  /// may have moved on to version 3 by the time this pair is remade.
  lensRx         Json?
  /// Which saved prescription this came from, for the customer's history.
  prescriptionId Int?

  lensType     LensType?     @relation(fields: [lensTypeId], references: [id], onDelete: SetNull)
  lensDesign   LensDesign?   @relation(fields: [lensDesignId], references: [id], onDelete: SetNull)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([prescriptionId])
  @@map("order_items")
}

model ContactMessage {
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("unread")
  createdAt DateTime @default(now())
  id        Int      @id @default(autoincrement())

  @@map("contact_messages")
}

model Advertisement {
  title      String
  // Optional: a product-driven placement can run on the linked product's own
  // photo, so an ad is publishable with artwork, with a product, or with both.
  imageUrl   String?
  link       String?
  placement  String
  status     String    @default("active")
  priority   Int       @default(0)
  slot       Int       @default(1)
  startDate  DateTime?
  endDate    DateTime?
  clickCount Int       @default(0)
  viewCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  id         Int       @id @default(autoincrement())
  productId  Int?
  product    Product?  @relation(fields: [productId], references: [id])

  @@index([status])
  @@index([placement])
  @@index([priority])
  @@index([productId])
  @@map("advertisements")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum ProductUnit {
  METER
  PIECES
  BOX
  DRUM
}

/// Eyewear brands. Separate from Category because one brand (e.g. Ray-Ban)
/// sells across several categories, which a child-category cannot express.
model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  logo      String?
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([status])
  @@map("brands")
}

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

enum FrameShape {
  RECTANGLE
  SQUARE
  ROUND
  OVAL
  CAT_EYE
  AVIATOR
  GEOMETRIC
  BROWLINE
}

enum RimType {
  FULL_RIM
  SEMI_RIMLESS
  RIMLESS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum AdvertisementStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  END_USER
  WHOLESALER
  RESELLER
  INSTALLER
  PROJECTS
  COMPANY
}

// Editable storefront content.
//
// Every non-catalogue block on the site  the announcement bar, the mega menu,
// the home page sections, the footer  is stored here as one row of JSON keyed
// by a stable string. The shape of each row is described in code by the block
// registry (src/features/site-content/constants/blocks.ts), which also supplies
// the defaults, so a missing row renders the shipped dummy content rather than
// an empty page. That keeps the schema stable while blocks gain fields.
model SiteContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

// A customer's review of a product.
//
// Reviews are user-generated, not editable site content: an admin can approve,
// reject or delete one, but never write one. New reviews land as PENDING so a
// human sees them before they reach the storefront.
//
// One review per customer per product (@@unique)  the write form switches to
// "edit your review" when a row already exists, rather than stacking duplicates.
model Review {
  id               Int          @id @default(autoincrement())
  rating           Int // 1–5
  title            String?
  body             String
  status           ReviewStatus @default(PENDING)
  // Set at submission time by checking the customer's delivered orders, so the
  // badge stays true even if the product is later removed from their history.
  verifiedPurchase Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  productId Int
  userId    Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([status])
  @@map("reviews")
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/// The shop's own customer book, used by the counter.
///
/// Separate from `User`: a walk-in customer has no login, no password and no
/// cart  only a phone number the cashier types to pull up their details and
/// their past bills. Someone who later creates a storefront account keeps both
/// records; the bill links to whichever one identified them.
model Customer {
  id             Int       @id @default(autoincrement())
  name           String
  /// The lookup key at the counter, so it has to be unique.
  phone          String    @unique
  email          String?
  address        String?
  city           String?
  /// Free notes the counter keeps  frame preference, collection instructions.
  notes          String?
  /// The customer said yes to hearing about offers. Off until they do: a
  /// phone number given to collect a bill is not permission to market to it.
  marketingOptIn Boolean   @default(false)
  /// When they last bought something, so the book can be read as a list of
  /// who to call and who has drifted away.
  lastVisitAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders Order[]

  @@index([name])
  @@index([marketingOptIn])
  @@index([lastVisitAt])
  @@map("customers")
}

/// One collection against a bill.
///
/// A bill can be settled in parts  half cash and half card, or an advance now
/// and the balance on collection  so payments are rows rather than a single
/// method column on the order.
model Payment {
  id               Int           @id @default(autoincrement())
  orderId          Int
  method           PaymentMethod
  /// Positive for a collection, negative for a refund against a return.
  amount           Float
  /// Card slip number, bank transfer reference, or a note on a refund.
  reference        String?
  /// The gateway's own payment id, for a row raised by an online payment.
  /// Unique because the gateway retries its notification until it is
  /// acknowledged: the second delivery of the same payment must not be able
  /// to write a second row and double the money collected.
  gatewayPaymentId String?       @unique
  createdAt        DateTime      @default(now())

  createdById Int?
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
  @@map("payments")
}

/// Every change to a product's stock, and why it happened.
///
/// `Product.stock` is the running count; this is the history behind it, so a
/// count that looks wrong can be traced back to the sale, the return or the
/// correction that moved it.
model StockMovement {
  id        Int         @id @default(autoincrement())
  productId Int
  /// Signed change: -2 sold, +10 received.
  delta     Int
  reason    StockReason
  /// The bill this movement belongs to, when there is one.
  orderId   Int?
  note      String?
  createdAt DateTime    @default(now())

  createdById Int?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order       Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([reason])
  @@map("stock_movements")
}

enum OrderChannel {
  ONLINE
  POS
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
}

enum StockReason {
  SALE
  ONLINE_ORDER
  RETURN
  VOID
  PURCHASE
  ADJUSTMENT
}

// ===========================================================================
//  Prescription lenses
// ===========================================================================
//
// A frame is a product; the lenses fitted into it are not. Their price does
// not come from a shelf count, it comes from the power that has to be ground
// into them — a -1.00 lens and a -9.00 lens are the same piece of plastic to
// the catalogue and very different money to the lab. So lenses live in their
// own small price list, maintained by the shop, and are quoted against the
// customer's prescription at the moment they choose.

/// One line on the lens menu — "Blue Cut", "Progressive", "Photochromic".
///
/// The long-form guide for each of these lives in `src/config/lenses.ts` and
/// is matched by `slug`; this table holds only what the shop actually
/// maintains — whether it is offered, what it costs, and in what order it is
/// shown. A type with no matching guide entry is still perfectly sellable, it
/// simply has no "Learn more" page behind it.
model LensType {
  id          Int     @id @default(autoincrement())
  /// Matches a `slug` in the lens guide when there is a guide page for it.
  slug        String  @unique
  name        String
  /// The single line shown under the name on the picker.
  description String?
  /// Free-text grouping used as a heading on the picker, e.g. "Multifocal".
  groupLabel  String?

  /// False for a plano/fashion lens, which is sold with no powers at all and
  /// is therefore priced from `basePrice` rather than from the bands.
  requiresPrescription Boolean @default(true)
  /// What the pair costs when no power banding applies — the whole price for
  /// a non-prescription lens, and the fallback for a prescription lens whose
  /// price list has not been filled in yet.
  basePrice            Float   @default(0)
  sortOrder            Int     @default(0)
  isActive             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designs    LensDesign[]
  tints      LensTint[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([isActive, sortOrder])
  @@map("lens_types")
}

/// One way a lens type is built, and the prices that go with it.
///
/// The shop sells more than one of each kind — a round-top and a flat-top
/// bifocal, a free-form and a Vision Max progressive — and they are different
/// money. So the design is a named row the shop maintains, not a fixed enum:
/// `kind` is what the software needs to know (does this need a reading
/// addition?), `name` is what the customer reads.
model LensDesign {
  id          Int            @id @default(autoincrement())
  lensTypeId  Int
  kind        LensDesignKind @default(SINGLE_VISION)
  /// What the customer sees: "Single Vision", "Bifocal — Round Top".
  name        String
  /// One line under the name in the picker.
  description String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lensType    LensType         @relation(fields: [lensTypeId], references: [id], onDelete: Cascade)
  powerPrices LensPowerPrice[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@unique([lensTypeId, name])
  @@index([lensTypeId, sortOrder])
  @@map("lens_designs")
}

/// One row of the shop's lens price list: "this type, in this power range,
/// costs this much for the pair".
///
/// Ranges are written in MINUS-CYLINDER form, which is what the bands are
/// matched against — a prescription written in plus cylinder is transposed
/// before it is priced, so the same glasses land in the same band whichever
/// way the optometrist wrote them down.
///
/// Bands are tried in `sortOrder` and the first one that fits wins, so a
/// narrow special case can be placed above a broad catch-all. A prescription
/// that fits no band is quoted as "ask us" rather than guessed at.
model LensPowerPrice {
  id           Int     @id @default(autoincrement())
  /// Which build of this lens the row prices. Every row belongs to exactly
  /// one, and the lens type follows from the design — storing it here as well
  /// would be a second copy of the same fact, free to drift out of step.
  lensDesignId Int
  /// Optional human label for the row, e.g. "Standard range".
  label        String?

  /// Sphere range, inclusive, signed dioptres.
  sphMin Float
  sphMax Float
  /// Cylinder range, inclusive, signed dioptres, minus-cyl convention. A row
  /// covering "no astigmatism to -2.00" is written -2.00 to 0.
  cylMin Float
  cylMax Float
  /// Reading addition range, inclusive. Null on both means the row does not
  /// care about the addition.
  addMin Float?
  addMax Float?

  /// Price for the PAIR of lenses in this range.
  price     Float
  sortOrder Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lensDesign LensDesign @relation(fields: [lensDesignId], references: [id], onDelete: Cascade)

  @@index([lensDesignId, sortOrder])
  @@map("lens_power_prices")
}

/// A tint or colour offered within one lens type — the six photochromic
/// colours, the three polarised ones. Priced as a surcharge on top of the
/// power band, because a brown polarised lens and a grey one are usually the
/// same money but not always.
model LensTint {
  id          Int     @id @default(autoincrement())
  lensTypeId  Int
  name        String
  /// Swatch fill for the picker — the tint itself, not the frame.
  hex         String?
  /// One line under the swatch name.
  description String?
  surcharge   Float   @default(0)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lensType  LensType   @relation(fields: [lensTypeId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([lensTypeId, name])
  @@index([lensTypeId, sortOrder])
  @@map("lens_tints")
}

/// How a lens is built: one power, two, or a smooth range between them.
///
/// This is a different axis from the lens TYPE. The shop's price list is a
/// grid — coatings across the top (uncoated, multicoat, blue cut), and down
/// the side the same three designs repeated for each of them. A "Blue Cut
/// Progressive" is not a lens type of its own, it is the blue cut lens built
/// as a progressive, which is why this hangs off the type rather than
/// multiplying it.
enum LensDesignKind {
  SINGLE_VISION // one power across the lens
  BIFOCAL // distance and reading, with a visible line
  PROGRESSIVE // distance to reading, no line
}

/// Where a set of powers came from.
enum PrescriptionSource {
  MANUAL // typed in by the customer
  UPLOAD // read off a photo or PDF, then confirmed by the customer
  STAFF // entered at the counter by the shop
}

/// A customer's spectacle prescription, kept so they never have to type it
/// twice.
///
/// Prescriptions are VERSIONED rather than edited. An eye test a year later
/// produces version 2 of the same record: the old powers stay exactly as they
/// were, because they are what an order already placed was made to, and the
/// customer can still see what they used to be. `rootId` chains the versions
/// together; the newest un-archived version of a chain is the one offered at
/// checkout.
model Prescription {
  id     Int @id @default(autoincrement())
  userId Int

  /// What the customer calls it — "Mine", "Amma's", "Driving pair".
  label   String             @default("My prescription")
  version Int                @default(1)
  /// Version 1 of this chain. Null on version 1 itself.
  rootId  Int?
  source  PrescriptionSource @default(MANUAL)

  /// Hidden from the picker without being destroyed: an order may point here.
  isArchived Boolean @default(false)

  /// What the prescriber said to make, when they said it.
  ///
  /// Doctors write "Bifocals", "PAL", "SV" on the slip, and this is the one
  /// question a customer genuinely cannot answer for themselves — plenty do
  /// not know which they were prescribed, and a reading addition alone does
  /// not settle it (it could be a bifocal, a progressive, or a separate pair
  /// of readers). Null means nobody has said, which is a normal state and not
  /// a missing value: the picker then explains the choice instead of
  /// pretending to know.
  prescribedDesign LensDesignKind?

  /// R2 key of the uploaded photo or PDF, when there was one.
  imageFile     String?
  /// What the reader was sure of, 0–1. Null when typed in by hand.
  ocrConfidence Float?

  /// When the optometrist wrote it, and when it should be re-tested. Both are
  /// optional: plenty of people no longer have the slip.
  issuedAt  DateTime?
  expiresAt DateTime?

  // ---- Right eye (OD) ----
  rightSph   Float?
  rightCyl   Float?
  rightAxis  Int?
  rightAdd   Float?
  rightPrism Float?
  rightBase  String?

  // ---- Left eye (OS) ----
  leftSph   Float?
  leftCyl   Float?
  leftAxis  Int?
  leftAdd   Float?
  leftPrism Float?
  leftBase  String?

  /// Pupillary distance in mm. Either one binocular figure, or the two
  /// monocular halves when the slip gives them separately.
  pdSingle Float?
  pdRight  Float?
  pdLeft   Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([userId, isArchived])
  @@index([rootId])
  @@map("prescriptions")
}

/// What the reader returned for one uploaded file, kept so the same photo is
/// never sent twice.
///
/// The key is the file's own SHA-256, so a customer who uploads, changes
/// their mind about the lens type and comes back is served from here rather
/// than from another paid API call — and so is a second customer uploading
/// the identical file. This is a cache, not a record: nothing here is shown
/// to anyone until it has been through the customer's own confirmation step,
/// and the row can be deleted at any time with no loss.
model PrescriptionExtraction {
  id       Int    @id @default(autoincrement())
  /// SHA-256 of the uploaded bytes, lower-case hex.
  fileHash String @unique
  provider String

  /// Exactly what the provider sent back, for debugging a bad read.
  raw        Json
  /// The optical fields we managed to recognise in it.
  parsed     Json
  /// The provider's own confidence, when it gives one.
  confidence Float?

  /// Storage key of the uploaded slip itself, under the private prefix.
  ///
  /// Held here rather than derived from the hash so that re-uploading the
  /// same file reuses the one object instead of writing another copy — and so
  /// the key itself can stay random, which is what stops it being guessable.
  storedFile String?

  createdAt DateTime @default(now())

  @@map("prescription_extractions")
}
