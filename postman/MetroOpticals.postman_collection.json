{
  "info": {
    "_postman_id": "d2c7a3f1-3e6a-45b8-9b74-8f0c7d1c0abc",
    "name": "Metro Opticals API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for testing the Metro Opticals backend. Includes auth (with dynamic CSRF handling), public, customer-protected, and admin endpoints."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "csrfToken", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "cartItemId", "value": "" },
    { "key": "wishlistItemId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "parentCategoryId", "value": "" },
    { "key": "subcategoryId", "value": "" },
    { "key": "categorySlug", "value": "" },
    { "key": "subcategorySlug", "value": "" },
    { "key": "productSlug", "value": "" },
    { "key": "advertisementId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api","auth","signup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Get CSRF",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/csrf", "host": ["{{baseUrl}}"], "path": ["api","auth","csrf"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.environment.set('csrfToken', data.csrfToken);",
                  "pm.collectionVariables.set('csrfToken', data.csrfToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Signin (Credentials)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('csrfToken')) {",
                  "  pm.sendRequest({ url: pm.environment.get('baseUrl') + '/api/auth/csrf', method: 'GET' }, (err, res) => {",
                  "    if (!err) {",
                  "      const t = res.json().csrfToken;",
                  "      pm.environment.set('csrfToken', t);",
                  "      pm.collectionVariables.set('csrfToken', t);",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/callback/credentials", "host": ["{{baseUrl}}"], "path": ["api","auth","callback","credentials"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "csrfToken", "value": "{{csrfToken}}" },
                { "key": "email", "value": "{{userEmail}}" },
                { "key": "password", "value": "{{userPassword}}" },
                { "key": "callbackUrl", "value": "{{baseUrl}}" },
                { "key": "json", "value": "true" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Session",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/session", "host": ["{{baseUrl}}"], "path": ["api","auth","session"] }
          },
          "response": []
        },
        {
          "name": "Signout",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('csrfToken')) {",
                  "  pm.sendRequest({ url: pm.environment.get('baseUrl') + '/api/auth/csrf', method: 'GET' }, (err, res) => {",
                  "    if (!err) {",
                  "      const t = res.json().csrfToken;",
                  "      pm.environment.set('csrfToken', t);",
                  "      pm.collectionVariables.set('csrfToken', t);",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/x-www-form-urlencoded" } ],
            "url": { "raw": "{{baseUrl}}/api/auth/signout", "host": ["{{baseUrl}}"], "path": ["api","auth","signout"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [ { "key": "csrfToken", "value": "{{csrfToken}}" } ]
            }
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api","auth","forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\"\n}" }
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api","auth","reset-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"<paste-token>\",\n  \"password\": \"newStrongPass123\"\n}" }
          },
          "response": []
        }
      ]
    },

