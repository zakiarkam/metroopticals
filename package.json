{
  "name": "metro-opticals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev -p 4500",
    "dev:clean": "rm -rf .next && next dev -p 4500",
    "dev:turbo": "next dev --turbo -p 4500",
    "build": "next build",
    "start": "next start -p ${PORT:-4500}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "deploy:release": "node prisma/release.mjs",
    "db:bootstrap": "node prisma/bootstrap.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "db:update": "prisma db push && prisma generate",
    "clean": "rm -rf .next node_modules/.cache",
    "fresh": "rm -rf .next node_modules/.cache && npm run dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@hookform/resolvers": "^5.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@reduxjs/toolkit": "^2.6.1",
    "autoprefixer": "10.4.15",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.24",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.553.0",
    "next": "^15.5.9",
    "next-auth": "^4.24.13",
    "postcss": "^8.5.6",
    "prisma": "^5.20.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.66.0",
    "react-hot-toast": "^2.6.0",
    "react-range-slider-input": "^3.0.7",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.5",
    "resend": "^4.8.0",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "winston": "^3.19.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "20.6.2",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.2.3",
    "ts-node": "^10.9.2",
    "typescript": "5.2.2"
  }
}
