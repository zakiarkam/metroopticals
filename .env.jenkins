# Jenkins Configuration Files
# Store these in Jenkins for pipeline use

# .env file for Jenkins
# Create as Secret File credential in Jenkins
# ID: metroopticals-env-file

DATABASE_URL=postgresql://metroopticals:metroopticals123@postgres:5432/metroopticals?schema=public
POSTGRES_USER=metroopticals
POSTGRES_PASSWORD=your-production-password
POSTGRES_DB=metroopticals

NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your-secret-here

# Cloudflare R2 storage
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
R2_BUCKET_NAME=your-bucket-name
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Metro Opticals <noreply@metroopticals.lk>

NODE_ENV=production
NEXT_PUBLIC_API_URL=https://your-domain.com

ADMIN_EMAIL=admin@metroopticals.com
ADMIN_PHONE=+1234567890
ADMIN_WHATSAPP=+1234567890
